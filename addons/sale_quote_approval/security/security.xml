<odoo>
    <record id="module_category_sales_management" model="ir.module.category">
            <field name="name">Quotations Approval</field>
            <field name="description">Helps you handle your quotations approval.</field>
            <field name="sequence">1</field>
        </record>

    <record id="group_sales_person" model="res.groups">
        <field name="name">Sales Person</field>
        <field name="category_id" ref="module_category_sales_management"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_sales_team_leader" model="res.groups">
        <field name="name">Sales Team Leader Approval</field>
        <field name="category_id" ref="module_category_sales_management"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <record id="group_sales_manager" model="res.groups">
        <field name="name">Sales Manager Approval</field>
        <field name="category_id" ref="module_category_sales_management"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager Approval</field>
        <field name="category_id" ref="module_category_sales_management"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
</odoo>
