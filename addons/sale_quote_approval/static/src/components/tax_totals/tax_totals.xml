<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-inherit="account.TaxTotalsField" t-inherit-mode="extension" owl="1">
        <xpath expr="//tbody" position="inside">
            <tr t-if="totals.total_cost_formatted">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_cost_label">Total Cost</label>
                </td>
                <td class="o_list_monetary">
                    <span
                        name="total_cost_formatted"
                        t-out="totals.total_cost_formatted"
                        style="font-size: 1.1em; font-weight: 600; white-space: nowrap;"
                    />
                </td>
            </tr>
        </xpath>
    </t>
</templates>